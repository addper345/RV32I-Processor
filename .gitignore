# ---------- Questa / ModelSim ----------
work/                 # compiled library (rebuilt by vlib/vlog)
transcript            # console log
*.wlf                 # waveform database (vsim.wlf)
wlft*                 # temporary waveform files
*.vstf                # stack trace files from crashes
*.ucdb                # coverage databases
qwave.db              # Visualizer waveform database
modelsim.ini          # library mappings, regenerated by vlib/vmap

# ---------- Quartus-launched simulation ----------
simulation/           # Quartus NativeLink output folder

# ---------- Waveform dumps ----------
*.vcd
*.fst

# ---------- Trace / logs ----------
*.log                 # e.g. dut_trace.log from trace comparison

